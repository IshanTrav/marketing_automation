# Copy this file to .env and fill in your real values — .env itself is gitignored.

# From aistudio.google.com/apikey
GEMINI_API_KEY=

# GCS bucket name (just the name, no gs:// prefix) — the one we already have
GCS_BUCKET_NAME=

# Path to a service account JSON key file with Storage Object Admin on that bucket.
# Console -> IAM & Admin -> Service Accounts -> create key -> download the JSON,
# save it somewhere OUTSIDE this repo, and point to it here.
GOOGLE_APPLICATION_CREDENTIALS=

# From the Graph API Explorer / API setup with Instagram login test
IG_ACCESS_TOKEN=
IG_USER_ID=
